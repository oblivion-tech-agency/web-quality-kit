{
  "name": "@oblivion/fx",
  "version": "0.1.0",
  "description": "Efectos de Oblivion: GSAP + Lenis para el movimiento, Three.js para el 3D. Cada efecto es vanilla (createX) y tiene su hook de React (useX).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": ">=18.2",
    "three": ">=0.170"
  },
  "peerDependenciesMeta": {
    "gsap": { "optional": true },
    "lenis": { "optional": true },
    "react": { "optional": true },
    "three": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "gsap": "^3.15.0",
    "happy-dom": "^21.0.4",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
